# Atlas 测绘系统本地环境变量引导模版 (.env.example)
# 本地非 Docker 运行时可复制为 .env 使用

# 日志输出级别: debug | info | warn | error
LOG_LEVEL=debug

# PostgreSQL 数据库连接串
ATLAS_PG_DSN=postgres://postgres:postgres@127.0.0.1:5432/atlas?sslmode=disable

# NATS 消息队列连接地址
ATLAS_NATS_URL=nats://127.0.0.1:4222

# Elasticsearch 资产存储服务地址
ATLAS_ES_ADDR=http://127.0.0.1:9200

# HTTP Web API 监听端口 (可选)
ATLAS_HTTP_ADDR=:8080
